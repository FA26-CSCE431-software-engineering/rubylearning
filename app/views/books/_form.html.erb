<% if alert.present? %>
  <p role="alert"><%= alert %></p>
<% end %>
<% if book.errors.any? %>
  <div role="alert">
    <p>Please correct the following:</p>
    <ul>
      <% book.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<%= form_with model: book do |form| %>
  <p>
    <%= form.label :title %><br>
    <%= form.text_field :title, required: true %>
  </p>
  <p>
    <%= form.label :author %><br>
    <%= form.text_field :author %>
  </p>
  <p>
    <%= form.label :price %><br>
    <%= form.number_field :price, step: "0.01", min: 0 %>
  </p>
  <p>
    <%= form.label :published_date %><br>
    <%= form.date_select :published_date, start_year: 1800, end_year: Date.current.year + 5, include_blank: true %>
  </p>
  <%= form.submit %>
<% end %>
