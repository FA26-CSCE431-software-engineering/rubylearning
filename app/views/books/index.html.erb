<h1>Book Collection</h1>
<p>Keep track of the books in your collection.</p>
<% if notice.present? %>
  <p role="status"><%= notice %></p>
<% end %>
<p><%= link_to "Add a book", new_book_path %></p>
<% if @books.empty? %>
  <p>No books yet. Add your first book to get started.</p>
<% else %>
  <table>
    <thead><tr><th>Title</th><th>Author</th><th>Price</th><th>Published date</th><th>Actions</th></tr></thead>
    <tbody>
      <% @books.each do |book| %>
        <tr>
          <td><%= book.title %></td>
          <td><%= book.author %></td>
          <td><%= number_to_currency(book.price) %></td>
          <td><%= book.published_date %></td>
          <td><%= link_to "Show", book_path(book) %> |
              <%= link_to "Update", edit_book_path(book) %> |
              <%= link_to "Delete", delete_book_path(book) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
