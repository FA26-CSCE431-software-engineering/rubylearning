<h1>Users</h1>
<% if notice.present? %><p role="status"><%= notice %></p><% end %>
<nav><%= link_to "User Books", root_path %> | <%= link_to "Books", books_path %> | <%= link_to "New user", new_user_path %></nav>
<table>
  <thead><tr><th>Username</th><th>Actions</th></tr></thead>
  <tbody>
    <% @users.each do |user| %>
      <tr><td><%= user.username %></td><td><%= link_to "Show", user %> | <%= link_to "Edit", edit_user_path(user) %></td></tr>
    <% end %>
  </tbody>
</table>
